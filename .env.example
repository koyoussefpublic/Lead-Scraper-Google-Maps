# ==============================================================================
# Google Maps Lead Scraper & CarteFidele CRM - Environment Configuration
# ==============================================================================

# --- Environment & External Messaging Safety ---
# Set to 'development' locally (enforces Mock WhatsApp & simulated email sends).
# Set to 'production' on Railway when ready for live outreach.
APP_ENV=development
ALLOW_EXTERNAL_MESSAGING=false

# --- Email Outreach (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@outreach.cartefidele.com
RESEND_REPLY_TO=contact@cartefidele.com
# Optional webhook signing secret from Resend
RESEND_WEBHOOK_SECRET=

# --- WhatsApp Outreach (Self-Hosted Evolution API on Railway) ---
# Local development MUST keep WHATSAPP_ENABLED=false and WHATSAPP_PROVIDER=mock
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=mock
EVOLUTION_API_ENABLED=false
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_API_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=

# --- CRM Database ---
# Optional override; defaults to <OUTPUT_DIR>/crm.db
# CRM_DB_PATH=/app/output/crm.db

# --- Authentication & Security ---
# Credentials required to access the web dashboard and private API endpoints
APP_USERNAME=admin
APP_PASSWORD=ChangeThisPasswordToSomethingSecure!
# Optional: Pre-hashed password generated via PBKDF2
# APP_PASSWORD_HASH=pbkdf2_sha256$100000$salt$hash

# Secret key used for signing session cookies and HMAC tokens (generate a long random string)
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production

# Session cookie lifetime in seconds (default: 604800 = 7 days)
SESSION_MAX_AGE=604800

# Rate limiting for API requests (default: 60 requests per 60 seconds per IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60


# --- Server & Railway Deployment ---
# Port Railway assigns automatically via $PORT
PORT=8000
HOST=0.0.0.0

# Persistent storage mount point for generated CSV and Excel files
# When attaching a Railway Volume, mount it at /app/output
OUTPUT_DIR=/app/output


# --- Queue & Worker Architecture ---
# Maximum concurrent browser scraping jobs allowed (default: 1 to avoid IP blocks)
CONCURRENCY_LIMIT=1

# Optional Redis connection URL for distributed Worker deployment
# If left blank, the application uses an in-process async queue (zero external dependencies required)
# REDIS_URL=redis://default:password@redis.railway.internal:6379
# REDIS_QUEUE_KEY=gmaps_scraper:jobs_queue


# --- Browser & Scraper Behavior ---
# Must be true for Docker / Railway headless Linux containers
HEADLESS=true

# Optional HTTP/SOCKS5 proxy (e.g. http://user:pass@proxy.example.com:8080)
# SCRAPER_PROXY=

# Delays between Google Maps actions (seconds)
# SCRAPER_SEARCH_DELAY_MIN=5.0
# SCRAPER_SEARCH_DELAY_MAX=10.0
# SCRAPER_SCROLL_DELAY_MIN=1.5
# SCRAPER_SCROLL_DELAY_MAX=3.5

# Anti-Detection backoff settings
# SCRAPER_CAPTCHA_PAUSE_SECONDS=300
# SCRAPER_MAX_CONSECUTIVE_BLOCKS=4
